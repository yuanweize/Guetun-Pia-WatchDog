# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Copy this to .env and fill in your PIA credentials
# ══════════════════════════════════════════════════════════════════════════════

# ── PIA Credentials (REQUIRED) ──────────────────────────────────────────────
PIA_USER=p1234567
PIA_PASS=your_pia_password_here

# ── PIA Server Selection ─────────────────────────────────────────────────────
# "none" = auto-select lowest latency server with port forwarding
# Or set a region ID (find them with: docker run --rm ghcr.io/yuanweize/gluetun-pia-watchdog list-servers --pf)
PREFERRED_REGION=none
MAX_LATENCY=0.1
PIA_PF=true

# ── Dynamic WireGuard Config (auto-generated — DO NOT EDIT below) ────────────
SERVER_NAMES=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
